# ── GridPulse AI — Environment Variables ─────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── App Settings ──────────────────────────────────────────────────────────────
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://gridpulse:gridpulse_secret@localhost:5432/gridpulse
POSTGRES_USER=gridpulse
POSTGRES_PASSWORD=gridpulse_secret
POSTGRES_DB=gridpulse

# ── Neo4j ─────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=gridpulse_neo4j

# ── IBM watsonx.ai ────────────────────────────────────────────────────────────
# Leave blank to use the Local Fallback advisory engine.
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-13b-instruct-v2

# ── Risk Engine Weights (optional overrides) ──────────────────────────────────
# WEIGHT_FAILURE_PROBABILITY=0.30
# WEIGHT_ASSET_HEALTH=0.20
# WEIGHT_WEATHER=0.15
# WEIGHT_GRID_IMPACT=0.20
# WEIGHT_CASCADE=0.15
